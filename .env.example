# ============================================================
# VARIABLES DE ENTORNO — COPIA ESTE ARCHIVO A .env.local
# y rellena con tus claves reales. NUNCA subas .env.local al repo.
# ============================================================

# --- Supabase ---
# Consiguelas en: https://supabase.com -> Tu Proyecto -> Settings -> API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_publica_aqui

# --- Configuracion de la Tienda (Opcional, se puede gestionar desde el panel) ---
# Numero de WhatsApp del vendedor (con codigo de pais, sin + ni espacios)
# Ejemplo Colombia: 573001234567 | Mexico: 521234567890
VITE_WHATSAPP_NUMBER=573001234567

# --- Modo Demo (sin Supabase, usa datos mock locales) ---
# Pon "true" para desarrollar sin configurar Supabase todavia
VITE_DEMO_MODE=true
