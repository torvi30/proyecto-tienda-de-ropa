# ============================================================
# VARIABLES DE ENTORNO — PLANTILLA DE EJEMPLO
# Copia este archivo como .env.local y coloca tus valores reales.
# NUNCA subas .env.local al repositorio.
# ============================================================

# --- Firebase Client Config ---
VITE_FIREBASE_API_KEY=tu_firebase_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
VITE_FIREBASE_APP_ID=tu_app_id_aqui

# --- Cloudinary ---
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
VITE_CLOUDINARY_API_KEY=tu_api_key
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset

# --- Configuración de la Tienda ---
# Número de WhatsApp con código de país (sin + ni espacios)
VITE_WHATSAPP_NUMBER=573001234567

# --- Modo Demo ---
# Pon "true" para simular datos sin conectar a Firebase
# Pon "false" para usar Firebase Auth y Firestore
VITE_DEMO_MODE=false
